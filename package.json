{
  "name": "ai-generated-cucumber-test-project",
  "version": "1.0.0",
  "description": "Fully automated Jira → Cucumber test generation pipeline. Developers only review PRs.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "pipeline": "tsx src/cli/pipeline.ts",
    "pipeline:dry": "tsx src/cli/pipeline.ts --dry-run",
    "generate": "tsx src/cli/generate.ts",
    "test:cucumber": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.config.js",
    "test:unit": "tsx --test src/pipeline/run.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "jira",
    "cucumber",
    "bdd",
    "automation",
    "ai",
    "playwright"
  ],
  "license": "MIT",
  "dependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@octokit/rest": "^21.1.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "playwright": "^1.50.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
