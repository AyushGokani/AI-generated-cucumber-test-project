# ── Jira (leave blank for local mock demo) ────────────
JIRA_BASE_URL=https://example.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PROJ
# JQL used when polling / batch-generating
JIRA_JQL=project = PROJ AND status = "Ready for Automation" AND labels = cucumber-auto
# Optional: transition IDs for status updates after PR / merge
JIRA_TRANSITION_IN_REVIEW=
JIRA_TRANSITION_DONE=

# ── LLM (OpenAI-compatible) ───────────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
# mock = offline demo (no API key). Use live when LLM_API_KEY is set.
LLM_MODE=mock

# ── GitHub ────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_OWNER=AyushGokani
GITHUB_REPO=AI-generated-cucumber-test-project
GITHUB_BASE_BRANCH=main

# ── App ───────────────────────────────────────────────
PORT=3000
WEBHOOK_SECRET=change-me
# Poll interval in minutes (0 = disabled; use webhooks only)
POLL_INTERVAL_MINUTES=0
DRY_RUN=false
LOG_LEVEL=info
