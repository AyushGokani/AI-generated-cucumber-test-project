# ── Jira ──────────────────────────────────────────────
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PROJ
# JQL used when polling / batch-generating
JIRA_JQL=project = PROJ AND status = "Ready for Automation" AND labels = cucumber-auto
# Optional: transition IDs for status updates after PR / merge
JIRA_TRANSITION_IN_REVIEW=
JIRA_TRANSITION_DONE=

# ── LLM (OpenAI-compatible) ───────────────────────────
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
# Set to "mock" to generate without calling an LLM (demo / offline)
LLM_MODE=live

# ── GitHub ────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_OWNER=AyushGokani
GITHUB_REPO=AI-generated-cucumber-test-project
GITHUB_BASE_BRANCH=main

# ── App ───────────────────────────────────────────────
PORT=3000
WEBHOOK_SECRET=change-me
# Poll interval in minutes (0 = disabled; use webhooks only)
POLL_INTERVAL_MINUTES=15
DRY_RUN=false
LOG_LEVEL=info
